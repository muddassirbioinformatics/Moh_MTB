manifest {
    name            = 'MTB_PIPELINE'
    description     = 'Whole-genome TB drug-resistance pipeline (WHO 2023 catalogue)'
    version         = '0.1.0-dev'
    nextflowVersion = '>=26.04'
}

params {
    mtbdata             = "${System.getenv('HOME')}/mtbdata"   // symlink to the MTB_DATA disk
    samplesheet         = null
    outdir              = "${params.mtbdata}/MTB_DATA/results"
    resources           = "${params.mtbdata}/MTB_DATA/resources"
    thresholds          = "${projectDir}/conf/thresholds.yaml"
    step_texts          = "${projectDir}/assets/step_texts"
    full_resource_check = false
    always_assemble     = false
    relatedness         = false
    relatedness_mask_depth = 10
    lab_name            = 'Laboratory name (set --lab_name)'
    operator            = "${System.getenv('USER')}"
    report_banner       = 'VALIDATION BUILD - NOT FOR CLINICAL USE'   // set to '' only after validation sign-off
    containers {
        report       = 'mtb-report:1.1.0'
        fastp        = 'quay.io/biocontainers/fastp:1.4.0--h43da1c4_0'
        mykrobe      = 'quay.io/biocontainers/mykrobe:0.13.0--py311h22b1866_5'
        sylph        = 'quay.io/biocontainers/sylph:1.0.0--hb42e459_0'
        kraken2      = 'quay.io/biocontainers/kraken2:2.17.2--pl5321h3be2455_0'
        bwa_samtools = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:f45ad9036aa41bb10f875a330fa877d8869018a1-0'
        mosdepth     = 'quay.io/biocontainers/mosdepth:0.3.14--h87be163_2'
        bcftools     = 'quay.io/biocontainers/bcftools:1.24--h118bc1c_4'
        lofreq       = 'quay.io/biocontainers/lofreq:2.1.5--py311h6385618_16'
        freebayes    = 'quay.io/biocontainers/freebayes:1.3.10--h3752d28_1'
        snpeff       = 'quay.io/biocontainers/snpeff:5.4'
        shovill      = 'quay.io/biocontainers/shovill:1.4.2--hdfd78af_1'
        minimap2     = 'quay.io/biocontainers/minimap2:2.31--h118bc1c_0'
        tbprofiler   = 'quay.io/biocontainers/tb-profiler:6.7.0--pyhdfd78af_0'
        multiqc      = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2'
        snp_dists    = 'quay.io/biocontainers/snp-dists:1.2.0--h577a1d6_0'
        iqtree       = 'quay.io/biocontainers/iqtree:3.1.4--h8471819_0'
    }
}

// scratch on the SSD (faster; cleared after sign-off). Results/resources stay on the external disk.
workDir = "${projectDir}/work"

docker {
    enabled    = true
    // the external disk is reached through ~/mtbdata; mount it at the same path in every container
    runOptions = "-u \$(id -u):\$(id -g) -v ${params.mtbdata}:${params.mtbdata}"
}

includeConfig 'conf/base.config'

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }

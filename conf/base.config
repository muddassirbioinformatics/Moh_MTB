// CPU / memory and container per step. Machine: 16 cores, 62 GB RAM.
executor {
    name   = 'local'
    cpus   = 14
    memory = '48 GB'
}

process {
    cpus      = 1
    memory    = 2.GB
    container = params.containers.report

    withName: 'INPUT_CHECK' { cpus = 2; memory = 2.GB }
    withName: 'FASTP'       { cpus = 8; memory = 8.GB; container = params.containers.fastp }
    withName: 'MYKROBE'     { cpus = 4; memory = 8.GB; container = params.containers.mykrobe }
    withName: 'SYLPH'       { cpus = 8; memory = 30.GB; container = params.containers.sylph }
    withName: 'KRAKEN2'     { cpus = 8; memory = 12.GB; container = params.containers.kraken2 }
    withName: 'ALIGN'       { cpus = 8; memory = 8.GB; container = params.containers.bwa_samtools }
    withName: 'MOSDEPTH'    { cpus = 4; memory = 4.GB; container = params.containers.mosdepth }
    withName: 'COVERAGE_SUMMARY' { memory = 4.GB }
    withName: 'BCFTOOLS_CALL|NORMALISE|CSQ|HET_SITES' { cpus = 2; memory = 4.GB; container = params.containers.bcftools }
    withName: 'LOFREQ'      { cpus = 8; memory = 8.GB; container = params.containers.lofreq }
    withName: 'FREEBAYES'   { cpus = 1; memory = 4.GB; container = params.containers.freebayes }
    withName: 'SHOVILL'     { cpus = 8; memory = 18.GB; container = params.containers.shovill }
    withName: 'CONTIG_ALIGN' { cpus = 4; memory = 4.GB; container = params.containers.minimap2 }
    withName: 'TBPROFILER'  { cpus = 8; memory = 8.GB; container = params.containers.tbprofiler }
    withName: 'MULTIQC'     { cpus = 2; memory = 4.GB; container = params.containers.multiqc }
    withName: 'CONSENSUS'   { cpus = 1; memory = 2.GB; container = params.containers.bcftools }
    withName: 'SNP_DISTS'   { cpus = 2; memory = 4.GB; container = params.containers.snp_dists }
    withName: 'IQTREE'      { cpus = 4; memory = 8.GB; container = params.containers.iqtree }
    withName: 'SNPEFF'      { cpus = 1; memory = 4.GB; container = params.containers.snpeff }
}
